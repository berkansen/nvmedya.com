{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/invitation.js": {
      "includeFiles": "{data/invitations/**,templates/**}"
    }
  },
  "rewrites": [
    {
      "source": "/projeler/hepsert-spor-kulubu",
      "destination": "/projeler/hepsert-spor-kulubu.html"
    },
    {
      "source": "/projeler/nisan-vitrini",
      "destination": "/projeler/nisan-vitrini.html"
    },
    {
      "source": "/projeler/ufuk-sengun-yapi",
      "destination": "/projeler/ufuk-sengun-yapi.html"
    },
    {
      "source": "/projeler/muge-mutlu",
      "destination": "/projeler/muge-mutlu.html"
    },
    {
      "source": "/projeler/ufuk-sengun-sigorta",
      "destination": "/projeler/ufuk-sengun-sigorta.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog"
    },
    {
      "source": "/davetiye-demo",
      "destination": "/api/invitation?demo=hatice-mustafa-13-11-2026"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?<slug>[a-z0-9][a-z0-9-]*[a-z0-9])\\.nvmedya\\.com"
        }
      ],
      "destination": "/api/invitation?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/(admin-blog|board|panel|login)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none';"
        }
      ]
    },
    {
      "source": "/davetiye-demo",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), accelerometer=(), gyroscope=(), magnetometer=()"
        }
      ]
    }
  ]
}